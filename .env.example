# ---------------------------------------------------------------------------
# Nostrom - environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Deployer / vault owner private key (no 0x prefix is also accepted by ethers).
# Use a dedicated key funded only for testnet — never a key that holds real value.
PRIVATE_KEY=

# --- BOT Chain RPC endpoints (defaults come from the official dev docs) ------
# Testnet: Chain ID 968
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
# Mainnet: Chain ID 677
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# --- Constructor arguments for deployment ----------------------------------
# Wallet the AI agent signs heartbeats with (the "pulse" key).
AGENT_ADDRESS=
# Cold wallet that receives the treasury if the agent goes dark.
RECOVERY_ADDRESS=
# Timeout in seconds before the switch can be executed (86400 = 24 hours).
TIMEOUT_PERIOD=86400

# --- Agent heartbeat runtime ----------------------------------------------
# Deployed Nostrom vault address.
NOSTROM_ADDRESS=
# Private key held by the AI agent (must match AGENT_ADDRESS).
AGENT_PRIVATE_KEY=
# How often the agent pings, in seconds. Keep well below TIMEOUT_PERIOD.
PING_INTERVAL_SECONDS=3600

# --- Optional: contract verification --------------------------------------
BOTSCAN_API_KEY=
