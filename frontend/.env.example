# ---------------------------------------------------------------------------
# Nostrom frontend — environment configuration
# Copy to `.env` and fill in. Everything here is PUBLIC (Vite inlines VITE_*
# variables into the client bundle) — never put a private key in this file.
# ---------------------------------------------------------------------------

# --- Factory addresses, per chain ------------------------------------------
# There is no default. Deploy the factory, then paste the address printed by
# `npm run deploy:factory:testnet` (also written to
# deployments/factory-<network>-<chainId>.json).
#
# Without these, vault discovery and creation are disabled and the console says
# so plainly. Monitoring and execution still work from a bare vault address.
VITE_FACTORY_ADDRESS_968=
VITE_FACTORY_ADDRESS_677=
VITE_FACTORY_ADDRESS_31337=

# --- Network selection -----------------------------------------------------
# Chain offered when the wallet is on something unsupported. 968 = testnet.
VITE_DEFAULT_CHAIN_ID=968

# Expose the local Hardhat node (chainId 31337) as a selectable network.
# Leave unset in production builds.
VITE_ENABLE_LOCALHOST=false

# --- RPC overrides ---------------------------------------------------------
# Defaults come from hardhat.config.js. Override to use a private endpoint.
VITE_RPC_968=
VITE_RPC_677=

# --- Links -----------------------------------------------------------------
# Defaults to https://github.com/rapiip/nostrom when unset.
VITE_GITHUB_URL=
